---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from './SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const items = [
  { label: '使用文档', href: `${base}docs/overview/`, active: !pathname.includes('/changelog/') && !pathname.includes('/blog/') },
  { label: '更新日志', href: `${base}changelog/`, active: pathname.includes('/changelog/') },
  { label: 'Blog', href: `${base}blog/`, active: pathname.includes('/blog/') },
];
---

<div class="header">
  <div class="brand sl-flex">
    <SiteTitle />
    <nav class="section-nav" aria-label="网站栏目">
      {items.map((item) => (
        <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
  <div class="search sl-flex print:hidden"><Search /></div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons"><SocialIcons /></div>
    <ThemeSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: grid;
      grid-template-columns: minmax(0, auto) minmax(12rem, 1fr) auto;
      gap: 1.5rem;
      align-items: center;
      height: 100%;
    }
    .brand { align-items: center; gap: 1.75rem; min-width: 0; }
    .section-nav { display: flex; align-items: baseline; gap: 0.15rem; }
    .section-nav a {
      position: relative;
      padding: 0.35rem 0.55rem;
      color: var(--blade-muted);
      font-size: 0.84rem;
      font-weight: 500;
      text-decoration: none;
      white-space: nowrap;
    }
    .section-nav a:hover { color: var(--blade-ink); }
    .section-nav a[aria-current='page'] { color: var(--blade-ink); }
    .section-nav a[aria-current='page']::after {
      content: '';
      position: absolute;
      inset-inline: 0.55rem;
      bottom: 0.08rem;
      height: 1px;
      background: var(--blade-ink);
    }
    .search { min-width: 0; }
    .right-group, .social-icons { align-items: center; gap: 1rem; }
    .social-icons::after {
      content: '';
      height: 1.15rem;
      border-inline-end: 1px solid var(--blade-line);
    }
    @media (max-width: 72rem) { .section-nav { display: none; } }
    @media (max-width: 50rem) {
      .header { display: flex; justify-content: space-between; gap: var(--sl-nav-gap); }
      .brand { overflow: clip; }
    }
  }
</style>
