---
const base = import.meta.env.BASE_URL;
---

<a href={base} class="site-title" aria-label="Blade Agent 首页">
  <span class="blade-mark" aria-hidden="true"></span>
  <span class="wordmark">Blade Agent</span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      color: var(--blade-ink);
      text-decoration: none;
      white-space: nowrap;
    }
    .blade-mark {
      width: 0.38rem;
      height: 1.05rem;
      border-radius: 1px;
      background: var(--blade-ink);
    }
    .wordmark {
      font-family: var(--sl-font-heading);
      font-size: 0.98rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }
  }
</style>
