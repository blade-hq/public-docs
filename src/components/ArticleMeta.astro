---
import { getCollection } from 'astro:content';

const { slug } = Astro.props;
const entry = (await getCollection('docs')).find((item) => item.id.replace(/\/$/, '') === slug.replace(/\/$/, ''));
if (!entry) throw new Error(`ArticleMeta 找不到文章: ${slug}`);
const { date, author, role, tags = [], versions = [] } = entry.data;
const base = import.meta.env.BASE_URL;
const formatted = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'UTC' }).format(date).replaceAll('/', '-');
const minutes = Math.max(1, Math.ceil((entry.body?.replace(/\s+/g, '').length || 0) / 400));
const slugForVersion = (version: string) => version.replaceAll('.', '-');
---

<div class="article-meta">
  <span><strong>{author}</strong>{role ? `，${role}` : ''}</span>
  <time datetime={date.toISOString()}>{formatted}</time>
  <span>{minutes} 分钟</span>
  {tags.map((tag: string) => <span>{tag}</span>)}
</div>
{versions.length > 0 && (
  <p class="article-versions">相关版本：{versions.map((version: string, index: number) => <><a href={`${base}changelog/v${slugForVersion(version)}/`}>v{version}</a>{index < versions.length - 1 ? '、' : ''}</>)}</p>
)}
